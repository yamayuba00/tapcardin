# TapCard — konfigurasi instalasi server (deploy/install.sh).
# Salin ke server:  cp deploy/install.env.example /root/tapcard-install.env && nano /root/tapcard-install.env
# File ini berisi rahasia → simpan HANYA di server (chmod 600), jangan di-commit.

# ── Wajib ──────────────────────────────────────────────────────────────────────
# Domain utama tanpa http/www. Aplikasi memakai subdomain: app., tap., panel., dan {slug}. untuk perusahaan.
DOMAIN=tapcard.id
# Repo git aplikasi. Repo privat: pakai bentuk SSH (git@github.com:user/repo.git) — installer membuat
# deploy key dan berhenti sebentar agar Anda menambahkannya di GitHub → Settings → Deploy keys.
REPO_URL=git@github.com:yamayuba00/tapcardin.git
BRANCH=main
# Email Anda: akun Pemilik Platform (login panel.) + kontak Let's Encrypt.
ADMIN_EMAIL=

# ── Database ───────────────────────────────────────────────────────────────────
# external = PostgreSQL terkelola (mis. Sumopod) — isi DB_* di bawah.
# local    = installer memasang PostgreSQL 16 di VPS ini dan membuat user/database + password acak.
DB_MODE=external
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# true bila koneksi lewat PgBouncer (port 6432)
DB_EMULATE_PREPARES=false

# ── Email (SMTP) — wajib agar kode daftar & lupa password terkirim ─────────────
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
# Alamat pengirim; domainnya harus sudah diverifikasi di penyedia SMTP (SPF/DKIM). Kosong = noreply@DOMAIN
MAIL_FROM_ADDRESS=

# ── Sertifikat SSL ─────────────────────────────────────────────────────────────
# cloudflare = sertifikat WILDCARD (*.DOMAIN) lewat DNS Cloudflare — disarankan, subdomain perusahaan ikut aman.
#              Isi CLOUDFLARE_API_TOKEN (izin Zone → DNS → Edit untuk domain ini).
# http       = sertifikat untuk DOMAIN, www, app, tap, panel saja (tanpa wildcard). DNS harus sudah mengarah ke VPS.
# none       = lewati (hanya untuk uji; aplikasi butuh HTTPS)
SSL_MODE=cloudflare
CLOUDFLARE_API_TOKEN=

# ── Opsional ───────────────────────────────────────────────────────────────────
# Pembayaran langganan (Midtrans Snap). Kosong = checkout belum aktif sampai diisi di /var/www/tapcard/shared/.env
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=true
# Login Google (Google Cloud Console → OAuth client, redirect: https://app.DOMAIN/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ukuran pool PHP-FPM. Kosong = dihitung otomatis dari RAM VPS.
FPM_MAX_CHILDREN=
