APP_NAME=TapCard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapcard
DB_USERNAME=tapcard
DB_PASSWORD=secret

# TRD §3.2 — PostgreSQL dulu, Redis menyusul
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Tanpa "Ingat saya": sesi berakhir setelah 2 jam tidak aktif. Dengan centang: cookie login 7 hari (AUTH_REMEMBER_MINUTES).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
ADMIN_SESSION_COOKIE=tapcard_admin

TAPCARD_BASE_DOMAIN=localhost
# Kunci akses API (header X-Tap-Key) untuk semua /api kecuali endpoint tap. Produksi: wajib diisi (openssl rand -hex 32).
# Kosong di lokal = gerbang nonaktif. Kosong di produksi = API menjawab 503.
TAPCARD_API_KEY=
TAPCARD_RESOLVER_URL=http://tap.localhost:8000
TAPCARD_UID_PEPPER=
TAPCARD_IP_PEPPER=
# tap berulang dari pengunjung yang sama (IP + browser) ke kartu yang sama dalam N menit dihitung sekali (0 = hitung semua)
TAP_DEDUPE_MINUTES=30
# Paket kartu digital: kuota tap kumulatif per kartu + tambahan berbayar (kartu fisik tanpa kuota)
DIGITAL_TAP_QUOTA=1500
DIGITAL_TOPUP_TAPS=2000
DIGITAL_TOPUP_PRICE=70000
SEED_PLATFORM_OWNER_EMAIL=owner@example.com
SEED_PLATFORM_OWNER_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://app.localhost:8000/auth/google/callback

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# Email. log = hanya ditulis ke log (lokal). Produksi WAJIB smtp, kalau tidak pengingat/invoice tidak pernah terkirim.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@tapcard.local"
MAIL_FROM_NAME="TapCard"
# asal logo di email (harus bisa diakses publik; kosong = APP_URL) & tautan Pusat bantuan di footer
MAIL_ASSET_URL=
MAIL_HELP_URL=

# Alarm ke staf (koma = beberapa alamat): galat melonjak, antrean macet, backup gagal
ALERT_EMAILS=
ALERT_ERRORS_15M=10
ALERT_REMIND_HOURS=6
LOG_DAILY_DAYS=14

# Backup database harian (kosong = pakai bucket AWS di bawah)
BACKUP_DISK=
BACKUP_BUCKET=
BACKUP_DB_HOST=
BACKUP_DB_PORT=
BACKUP_KEEP_DAYS=30

# Panel pemilik: panel.{domain}
TAPCARD_PANEL_SUBDOMAIN=panel
# Merchandise masih "segera hadir"
MERCH_ENABLED=false

# Nomor WhatsApp tim sales (kode negara, angka saja) untuk tombol "Hubungi Sales" di landing. Kosong = disembunyikan.
TAPCARD_SALES_WHATSAPP=

# Landing page dirender server (Vue SSR lewat node, hasil di-cache) untuk mesin pencari & tampilan pertama.
# false / node tidak ada → landing tetap SPA biasa.
LANDING_SSR=true
LANDING_SSR_NODE=node
LANDING_SSR_TIMEOUT=5

# Captcha ALTCHA di formulir publik (isi kunci acak panjang di server)
ALTCHA_ENABLED=true
ALTCHA_HMAC_KEY=
ALTCHA_MAX_NUMBER=100000

# Pesanan, refund & persetujuan
ORDER_UNPAID_CANCEL_DAYS=3
ORDER_RISK_HIGH_VALUE=2000000
ORDER_RISK_NEW_ACCOUNT_VALUE=500000
ORDER_RISK_TERMS=
REFUND_CLAIM_WINDOW_DAYS=7
REFUND_NOT_DELIVERED_AFTER_DAYS=14
REFUND_OWNER_THRESHOLD=500000
APPROVAL_TTL_DAYS=3

VITE_APP_NAME="TapCard"

# Hanya untuk APP_ENV=local: semua login OTP memakai kode ini (kosongkan untuk mematikan)
DEV_LOGIN_CODE=

# Pembayaran (config/payment.php). simulator = halaman bayar tiruan, HANYA jalan di APP_ENV=local/testing.
# Produksi: link + isi PAYMENT_API_* & PAYMENT_WEBHOOK_SECRET dari dashboard gateway (jangan di-commit).
# Ongkir ekspedisi: dummy = tarif placeholder + resi simulasi (ganti setelah kontrak penyedia)
SHIPPING_DRIVER=dummy
SHIPPING_ORIGIN_ZONE=Jawa-Bali
SHIPPING_WEIGHT_PER_ITEM_GRAM=15
PAYMENT_DRIVER=simulator
PAYMENT_GATEWAY_NAME="Payment Gateway"
PAYMENT_GATEWAY_CODE=gateway
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_KEY_HEADER=X-Api-Key
PAYMENT_CREATE_PATH=/payments
PAYMENT_STATUS_PATH=/payments/{id}
PAYMENT_TIMEOUT=20
PAYMENT_METHOD=QRIS
PAYMENT_METHOD_LABEL="QRIS — semua e-wallet & mobile banking"
# batas bayar invoice checkout (menit) & umur link bayar di gateway (jam, min 1); link basi otomatis diganti
PAYMENT_INVOICE_TTL_MINUTES=30
PAYMENT_EXPIRES_HOURS=1
# webhook masuk: https://wbh.{domain}/payment — signature (Svix, secret whsec_…) | token | none
PAYMENT_WEBHOOK_VERIFY=signature
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOKEN=
PAYMENT_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
PAYMENT_WEBHOOK_TOLERANCE=300

# Penyimpanan objek S3-compatible (mis. Cloudeka). Isi kunci hanya di .env server — jangan di-commit.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=kencana
AWS_BUCKET=
AWS_ENDPOINT=https://kencana.basic.box.cloudeka.id
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
# s3 = unggahan publik disimpan di bucket (folder public/); local = storage/app/public
PUBLIC_DISK_DRIVER=local
# Gambar email blast: s3 = bucket yang sama, folder blast/ (bucket policy harus mengizinkan baca publik blast/*,
# kalau tidak gambar tidak tampil di email); local = storage/app/public/blast
BLAST_DISK_DRIVER=local
# Email blast: laju kirim maksimal per menit (antrean `mail`) & alamat perusahaan di footer email promo
BLAST_PER_MINUTE=60
MAIL_COMPANY_ADDRESS=

# Realtime (Laravel Reverb). REVERB_HOST/PORT/SCHEME = alamat publik WebSocket untuk browser
# (produksi: lewat Nginx, mis. ws.domain.com:443 https). REVERB_SERVER_* = alamat proses reverb:start di server.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
# batas waktu siaran ke Reverb (detik) agar worker tidak tergantung saat Reverb macet
REVERB_CONNECT_TIMEOUT=1
REVERB_TIMEOUT=2

# Redis (diisi otomatis oleh deploy/enable-redis.sh; lokal boleh kosong)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Webhook keluar ke localhost / jaringan internal — HANYA untuk uji lokal (APP_ENV=local), jangan di produksi
WEBHOOKS_ALLOW_PRIVATE=false
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
# REVERB_ALLOWED_ORIGINS=domain.com,*.domain.com
