APP_NAME=TapCard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapcard
DB_USERNAME=tapcard
DB_PASSWORD=secret

# TRD §3.2 — PostgreSQL dulu, Redis menyusul
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Tanpa "Ingat saya": sesi berakhir setelah 2 jam tidak aktif. Dengan centang: cookie login 7 hari (AUTH_REMEMBER_MINUTES).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
ADMIN_SESSION_COOKIE=tapcard_admin

TAPCARD_BASE_DOMAIN=localhost
TAPCARD_RESOLVER_URL=http://tap.localhost:8000
TAPCARD_UID_PEPPER=
TAPCARD_IP_PEPPER=
SEED_PLATFORM_OWNER_EMAIL=owner@example.com
SEED_PLATFORM_OWNER_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://app.localhost:8000/auth/google/callback

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tapcard.local"
MAIL_FROM_NAME="TapCard"

VITE_APP_NAME="TapCard"

# Hanya untuk APP_ENV=local: semua login OTP memakai kode ini (kosongkan untuk mematikan)
DEV_LOGIN_CODE=

# Pembayaran langganan (simulator = halaman bayar tiruan di lokal; midtrans = Snap)
TAPCARD_PAYMENT_DRIVER=simulator
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
