<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_ARRAY_SERIALIZE" value="true"/>
        <!-- Test SELALU ke Postgres lokal (RefreshDatabase menghapus semua tabel), apa pun isi .env.
             force="true" mencegah .env yang mengarah ke server lain ikut terpakai. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="tapcard_test" force="true"/>
        <env name="DB_USERNAME" value="tapcard" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_SSLMODE" value="prefer" force="true"/>
        <env name="DB_EMULATE_PREPARES" value="false" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="PUBLIC_DISK_DRIVER" value="local" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="TAPCARD_BASE_DOMAIN" value="localhost"/>
        <env name="TAPCARD_RESOLVER_URL" value="http://tap.localhost"/>
        <env name="TAPCARD_IP_PEPPER" value="test-ip-pepper"/>
        <env name="TAPCARD_UID_PEPPER" value="test-uid-pepper"/>
        <env name="ALTCHA_MAX_NUMBER" value="2000"/>
        <env name="SEED_PLATFORM_OWNER_EMAIL" value="owner@tapcard.test"/>
    </php>
</phpunit>
