APP_NAME=TapCard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.tapcardin.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tapcard
DB_USERNAME=tapcard
DB_PASSWORD=
DB_SSLMODE=require
# PgBouncer (port 6432): aktifkan emulasi prepared statement
DB_EMULATE_PREPARES=true

# TRD §3.2 — PostgreSQL dulu, Redis menyusul
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Tanpa "Ingat saya": sesi berakhir setelah 2 jam tidak aktif. Dengan centang: cookie login 7 hari (AUTH_REMEMBER_MINUTES).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
ADMIN_SESSION_COOKIE=tapcard_admin

TAPCARD_BASE_DOMAIN=tapcardin.my.id
TAPCARD_RESOLVER_URL=https://tap.tapcardin.my.id
TAPCARD_UID_PEPPER=
TAPCARD_IP_PEPPER=
# tap berulang dari pengunjung yang sama (IP + browser) ke kartu yang sama dalam N menit dihitung sekali (0 = hitung semua)
TAP_DEDUPE_MINUTES=30
# Paket kartu digital: kuota tap kumulatif per kartu + tambahan berbayar (kartu fisik tanpa kuota)
DIGITAL_TAP_QUOTA=1500
DIGITAL_TOPUP_TAPS=2000
DIGITAL_TOPUP_PRICE=70000
SEED_PLATFORM_OWNER_EMAIL=
SEED_PLATFORM_OWNER_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.tapcardin.my.id/auth/google/callback

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb
# Realtime (Reverb) — diisi otomatis oleh deploy/install.sh. Browser: wss://ws.<domain> (Nginx → 127.0.0.1:8080)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@tapcardin.my.id"
MAIL_FROM_NAME="TapCard"

# Alarm email bila tapcard:health gagal (tiap 5 menit). Kosong = semua staf Pemilik Platform.
# Isi agar alarm tetap terkirim walau database mati; pisahkan dengan koma.
ALERT_EMAILS=

# Backup database harian 02:15 WIB ke S3 (folder backups/, privat). Kosongkan untuk mematikan.
BACKUP_DISK=backups
BACKUP_KEEP_DAYS=30
# Bila DB_PORT mengarah ke PgBouncer (6432), isi port langsung PostgreSQL untuk pg_dump
BACKUP_DB_PORT=

VITE_APP_NAME="TapCard"


# --- Produksi ---
# DEV_LOGIN_CODE sengaja tidak ada: kode login dev hanya berlaku saat APP_ENV=local.
# TAPCARD_UID_PEPPER / TAPCARD_IP_PEPPER: isi string acak 32+ karakter dan JANGAN diganti setelah live.
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=

# Redis untuk antrean & cache — JANGAN isi manual: jalankan deploy/enable-redis.sh (memasang Redis, password acak,
# mengisi baris di bawah, menguji, lalu restart worker). SESSION_DRIVER tetap database: fitur blokir pengguna &
# "keluarkan dari semua perangkat" di panel membaca tabel sessions.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

# Pembayaran langganan (config/payment.php). link = gateway "payment link" via REST (mis. QRIS).
PAYMENT_DRIVER=link
# Nama yang dilihat pengguna & kode penyedia (maks 16 karakter, tersimpan di invoice)
PAYMENT_GATEWAY_NAME="QRIS"
PAYMENT_GATEWAY_CODE=qris
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_KEY_HEADER=X-Api-Key
PAYMENT_CREATE_PATH=/payments
PAYMENT_STATUS_PATH=/payments/{id}
PAYMENT_METHOD=QRIS
PAYMENT_METHOD_LABEL="QRIS — semua e-wallet & mobile banking"
PAYMENT_EXPIRES_HOURS=1
# Invoice yang belum dibayar batal otomatis setelah N menit (bayar lagi = invoice baru)
PAYMENT_INVOICE_TTL_MINUTES=30
# Pesanan belum dibayar batal otomatis setelah N hari (pengingat sehari sebelumnya)
ORDER_UNPAID_CANCEL_DAYS=3
# Webhook ke https://<domain>/webhooks/payment — signature (secret "whsec_…") | token | none (status selalu dicek ke API)
PAYMENT_WEBHOOK_VERIFY=signature
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOKEN=
